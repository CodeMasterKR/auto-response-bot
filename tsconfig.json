{
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment
    "module": "commonjs",      
    "target": "ES2020",
    "lib": ["ES2020"],
    "types": ["node"],          

    // Other Outputs
    "sourceMap": true,
    "declaration": true,

    // Stricter Typechecking
    "strict": true,
    "noUncheckedIndexedAccess": true,

    // Module Resolution
    "moduleResolution": "node",
    "esModuleInterop": true,   
    "allowSyntheticDefaultImports": true,

    // Misc
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true   
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}